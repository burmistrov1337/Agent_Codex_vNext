# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_POLL_TIMEOUT_SECONDS=20

# Wildberries
WB_API_TOKEN=

# LLM backends
PRIMARY_REASONING_BACKEND=deterministic
BACKGROUND_BACKEND=deterministic
CHEAP_BACKEND=deterministic
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Runtime paths
RUNTIME_ROOT=.agent_codex
TELEGRAM_INBOX_ROOT=.agent_codex/telegram/inbox
TELEGRAM_STATE_ROOT=.agent_codex/telegram/state
MARKETPLACE_ARTIFACT_ROOT=.agent_codex/artifacts/marketplace

# n8n / server defaults
GENERIC_TIMEZONE=Asia/Novosibirsk
TZ=Asia/Novosibirsk
N8N_BIND_ADDRESS=127.0.0.1
N8N_PORT=5678
