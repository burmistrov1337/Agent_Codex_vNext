{
  "name": "Agent_Codex vNext Marketplace Dashboard",
  "nodes": [
    {
      "id": "manual-1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [220, 200],
      "parameters": {}
    },
    {
      "id": "schedule-1",
      "name": "Weekly Monday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 360],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [1],
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "run-watch",
      "name": "Run Marketplace Watch",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [640, 280],
      "parameters": {
        "command": "python -m agent_codex.apps.cli.main marketplace-watch --project-root /app --headless --notify-telegram"
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Run Marketplace Watch", "type": "main", "index": 0 }]]
    },
    "Weekly Monday 08:00": {
      "main": [[{ "node": "Run Marketplace Watch", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "timezone": "Asia/Novosibirsk"
  }
}
