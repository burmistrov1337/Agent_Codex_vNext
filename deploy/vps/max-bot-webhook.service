[Unit]
Description=MAX bot webhook server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/max_bot/app
Environment=MAX_APP_ENV=server
EnvironmentFile=/opt/max_bot/.env
ExecStart=/opt/max_bot/venv/bin/python -m max_bot.webhook
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
